{
  "name": "nexy-auth-client-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript contracts for nexy-auth clients",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:types": "tsc --noEmit",
    "verify": "pnpm run check:types && pnpm run test:coverage"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
